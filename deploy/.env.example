# Copy to deploy/.env on the VPS:  cp .env.example .env && chmod 600 .env
# Keep comments on their own lines (no "# ..." after a value).
# Generate secrets with:  openssl rand -hex 24

APP_ENV=production

# Your GitHub username in lowercase (only used when pulling images from GHCR)
GHCR_OWNER=your-github-username

# Shared secret between the app and the server. Enter it on the phone: Settings -> Server -> API key
API_KEY=change-me
# Password for /admin/* (user "admin")
ADMIN_PASSWORD=change-me
# Letters and digits only (it goes inside the database URL)
DB_PASSWORD=change-me
# Encrypts stored message text. Generate with:  openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# Public address of the API (used in screenshot links)
PUBLIC_BASE_URL=https://api.yourdomain.in

DEEP_SCAN_ENABLED=true
SANDBOX_ENABLED=true

# demo = every report goes to DEMO_RECIPIENTS only. live = real authorities (verify backend/data/authorities.yaml first)
REPORT_MODE=demo
REPORTS_ENABLED=true
DEMO_RECIPIENTS=reports-demo@yourdomain.in

# Company mailbox that sends the reports (Hostinger Email shown; Zoho: smtp.zoho.in)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=reports@yourdomain.in
SMTP_PASSWORD=change-me
MAIL_FROM=ScamShield Reports <reports@yourdomain.in>
MAIL_REPLY_TO=reports@yourdomain.in

# Optional threat feeds. abuse.ch key (URLhaus) from https://auth.abuse.ch
ABUSECH_AUTH_KEY=
GOOGLE_SAFEBROWSING_KEY=
