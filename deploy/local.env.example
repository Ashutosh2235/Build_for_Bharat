# Server settings for running ScamShield on your PC. The launcher copies this to local.env
# and fills in the secrets on first run. Keep comments on their own lines.

APP_ENV=production
API_KEY=
ADMIN_PASSWORD=
DB_PASSWORD=
FERNET_KEY=

# Leave empty: the address is taken from the tunnel automatically
PUBLIC_BASE_URL=

DEEP_SCAN_ENABLED=true
SANDBOX_ENABLED=true

REPORT_MODE=demo
REPORTS_ENABLED=true
# Where demo reports are emailed (your team inbox)
DEMO_RECIPIENTS=

# Email sending. Leave SMTP_HOST empty to save reports as files instead (get them with: run-local reports).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=<16-letter app password from myaccount.google.com/apppasswords (needs 2-step verification)>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ScamShield Reports <you@gmail.com>
MAIL_REPLY_TO=

# Optional: fixed address via your Cloudflare domain (see docs/2_SERVER_ON_PC.md, section 5.3)
TUNNEL_TOKEN=

# Link-check services (all optional; see docs/2_SERVER_ON_PC.md section 5)
# Free key from https://auth.abuse.ch — turns on the URLhaus and ThreatFox feeds
ABUSECH_AUTH_KEY=
# Free key (Google Cloud console > APIs > Safe Browsing API) — turns on Google Safe Browsing
GOOGLE_SAFEBROWSING_KEY=
# Quad9 + Cloudflare protective-DNS check, no key needed
SECURE_DNS_ENABLED=true
# Certificate history via crt.sh (no key)
CRTSH_ENABLED=true
